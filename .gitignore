# No trailing slash: also ignore a *symlinked* node_modules (a trailing-slash
# pattern matches directories only, so `git add -A` in a worktree with a
# node_modules symlink would otherwise commit it and break the Docker build).
node_modules
web/node_modules
web/dist/
.env
service-account.json

# Local tooling caches
.impeccable/

# Firebase CLI debug output
firebase-debug.log
*-debug.log

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Playwright MCP session artifacts
.playwright-mcp/
rentredi-*.png

# Stray root-level PNG screenshots (assets live under web/)
/*.png
