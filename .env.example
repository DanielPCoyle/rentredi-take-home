# --- Server -----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# --- Analytics (optional) ----------------------------------------------------
# Google Analytics 4 Measurement ID. When set, the frontend loads gtag.js and
# tracks page views + events (user_created / user_updated / user_deleted,
# theme_toggle, location_select). Absent -> no analytics is loaded.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Error monitoring (Sentry, optional) -------------------------------------
# When SENTRY_DSN is set, the server reports unhandled 5xx errors to Sentry;
# unset -> Sentry is a complete no-op (tests/CI/local unaffected). Get a DSN from
# your Sentry project settings. SENTRY_DSN is a secret — never commit a real one.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production        # defaults to NODE_ENV or "development"
# SENTRY_TRACES_SAMPLE_RATE=0          # 0 = errors only; 0..1 to sample perf tracing
#
# Browser (frontend) Sentry DSN. Separate from the server DSN above so browser
# and server errors can target different Sentry projects. A DSN is a public
# client key — this one is intentionally exposed to the browser via /api/config.
# Unset -> the frontend loads no Sentry. (Fine to reuse the server DSN value.)
# SENTRY_DSN_WEB=https://<key>@<org>.ingest.sentry.io/<project>

# --- OpenWeatherMap ----------------------------------------------------------
# Get a free key at https://openweathermap.org/api. This is a secret — never commit a real one.
OWM_API_KEY=your_openweathermap_api_key_here
OWM_BASE_URL=https://api.openweathermap.org/data/2.5
OWM_TIMEOUT_MS=5000
DEFAULT_COUNTRY=US
# Set to 1 to bypass OpenWeatherMap with deterministic data (used by e2e tests).
OWM_MOCK=0

# --- Database ----------------------------------------------------------------
# Default driver is an in-memory store (zero setup). To use Firebase Realtime
# Database (the bonus), uncomment DB_DRIVER and provide the admin credential.
# DB_DRIVER=firebase
# FIREBASE_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com
# Admin credential: a path to a service-account JSON file, OR the JSON inline.
# FIREBASE_SERVICE_ACCOUNT=./service-account.json

# --- Frontend live sync (ReactFire) ------------------------------------------
# Public web config handed to the browser so ReactFire can subscribe to the
# Realtime Database directly. Present -> UI shows live updates; absent -> polls.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# FIREBASE_PROJECT_ID=<project>
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=

# --- Firebase Cloud Functions hosting (optional deploy target) ----------------
# On Cloud Functions the vars above are NOT read from a .env: firebase-functions
# REJECTS any .env containing reserved-prefix keys (FIREBASE_*, GOOGLE_*,
# GCLOUD_*), which is exactly what this app uses. The function (index.js) instead
# takes config via a secret + NON-reserved params and maps them at runtime:
#   * OWM_API_KEY -> a secret:   firebase functions:secrets:set OWM_API_KEY
#   * RTDB_URL    -> optional param; empty = derived from the project's own
#                    default RTDB (https://<project>-default-rtdb.firebaseio.com)
#   * WEB_FB_API_KEY / WEB_FB_APP_ID / WEB_FB_SENDER_ID -> optional params that
#                    enable browser live-sync; unset = the UI polls instead.
# firebase-admin uses the function's own service account (ADC) — do NOT set
# FIREBASE_SERVICE_ACCOUNT. Provide non-secret params via `.env.<projectId>`
# using only these non-reserved names. IMPORTANT: run `firebase deploy` from a
# tree WITHOUT a local .env that has FIREBASE_*/GOOGLE_* keys (deploy from CI, or
# move .env aside) or the deploy fails to load env. See README + .claude/rules/.
